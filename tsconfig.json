{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@xidr/agent-sdk/*": ["packages/agent-sdk/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "tests", "**/node_modules"]
}
