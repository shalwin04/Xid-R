# Xid-R Environment Configuration

# Environment
ENVIRONMENT=development

# GCP Configuration
GCP_PROJECT_ID=xidr-demo
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# GKE Configuration
GKE_CLUSTER_NAME=xidr-cluster
GKE_GPU_NODE_POOL=gpu-pool

# Cloud Storage
CHECKPOINT_BUCKET=xidr-demo-checkpoints

# Firestore
FIRESTORE_DATABASE=(default)

# API Server
API_HOST=0.0.0.0
API_PORT=8080
DEBUG=true

# Dashboard
DASHBOARD_WS_PORT=8081
FIREBASE_DATABASE_URL=https://xidr-demo-default-rtdb.firebaseio.com

# Capacity Fabric
UTILIZATION_POLL_INTERVAL_MS=30000
IDLE_THRESHOLD_PERCENT=15
HARVESTABLE_IDLE_DURATION_MS=300000

# Negotiation
NEGOTIATION_TIMEOUT_MS=60000
CHECKPOINT_TIMEOUT_MS=90000

# Pricing
GAIN_SHARE_PERCENT=15

# Google Application Credentials (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
